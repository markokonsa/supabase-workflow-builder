# Copy to .env (git-ignored) and fill in. Read by server code only:
# the /api/flows routes and the Workflow SDK steps in src/workflows.

# Supabase project the durable steps run against. When set, it overrides the URL typed in the canvas.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=            # or SUPABASE_PUBLISHABLE_KEY

# Needed only if a Role/Auth node uses service_role. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=    # or SUPABASE_SECRET_KEY

# Needed only if a Role/Auth node signs in as "authenticated".
WF_PASSWORD=
